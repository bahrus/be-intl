{
    "enhConfig": {
        "enhKey": "BeIntl",
        "spawn": "be-intl/be-intl.js",
        "withAttrs": {
            "base": "be-intl",
            "_base": {
                "mapsTo": "format",
                "instanceOf": "Object",
                "valIfNull": {}
            },
            "style": "${base}-style",
            "currency": "${base}-currency",
            "weekday": "${base}-weekday",
            "year": "${base}-year",
            "month": "${base}-month",
            "day": "${base}-day",
            "observeLang": "${base}-observe-lang",
            "_observeLang": {
                "instanceOf": "Boolean"
            }
        }
    },
    "customData": {
        "weakRef": {
            "properties": [
                "enhancedElement"
            ]
        },
        "actions": {
            "hydrate": {
                "ifAllOf": [
                    "enhancedElement",
                    "initialized"
                ],
                "ifKeyIn": [
                    "initialized"
                ],
                "debug": true
            },
            "onFormattingChange": {
                "ifAllOf": [
                    "locale",
                    "initialized"
                ],
                "ifKeyIn": [
                    "locale",
                    "format",
                    "initialized"
                ],
                "debug": true
            },
            "formatNumber": {
                "ifAllOf": [
                    "intlNumberFormat"
                ],
                "ifKeyIn": [
                    "value",
                    "intlNumberFormat"
                ],
                "debug": true
            },
            "formatDate": {
                "ifAllOf": [
                    "intlDateFormat"
                ],
                "ifKeyIn": [
                    "value",
                    "intlDateFormat"
                ],
                "debug": true
            }
        }
    }
}
